# Copy to .env.integration.local (ignored by Git); never commit secret values.
DB_PASSWORD=
# At least 32 bytes; use an independently generated secret.
JWT_SECRET=
# URL reachable from the backend container; no OSRM service is included.
OSRM_BASE_URL=

# Optional until the operational BRL/km tariff is approved; blank rejects new quotes.
FREIGHT_TARIFF_PER_KM=

# Keep the gateway outside the dynamic range and inside this dedicated subnet.
INTEGRATION_SUBNET=172.30.64.0/24
INTEGRATION_DYNAMIC_RANGE=172.30.64.128/25
GATEWAY_IPV4_ADDRESS=172.30.64.10
