{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "enum": [
        "STORE",
        "DISTRIBUTION_CENTER"
      ]
    },
    "storeId": {
      "type": "string",
      "format": "uuid"
    },
    "address": {
      "type": "object",
      "properties": {
        "line1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "line2": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "state": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "postalCode": {
          "type": "string",
          "pattern": "^\\d{5}-?\\d{3}$"
        },
        "country": {
          "const": "BR"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "line1",
        "city",
        "state",
        "country",
        "latitude",
        "longitude"
      ],
      "additionalProperties": false
    },
    "active": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "type",
    "storeId",
    "address",
    "active"
  ],
  "additionalProperties": true
}
