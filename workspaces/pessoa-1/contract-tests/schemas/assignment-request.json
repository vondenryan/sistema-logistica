{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "routeId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "originId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "requiredCapacityKg": {
      "type": "string",
      "pattern": "^(?=.*[1-9])(0|[1-9][0-9]*)(\\.[0-9]{1,3})?$"
    }
  },
  "required": [
    "routeId",
    "originId",
    "requiredCapacityKg"
  ],
  "additionalProperties": false
}
