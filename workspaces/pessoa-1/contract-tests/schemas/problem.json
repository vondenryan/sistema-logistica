{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "detail": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "array"
    },
    "traceId": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "type",
    "title",
    "status",
    "detail",
    "code",
    "details"
  ],
  "additionalProperties": true
}
