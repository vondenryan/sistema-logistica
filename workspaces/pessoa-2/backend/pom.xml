<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.7</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>br.com.sistemalogistica</groupId>
	<artifactId>pessoa2-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>pessoa2-backend</name>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration><compilerId>eclipse</compilerId></configuration>
				<dependencies>
					<dependency>
						<groupId>org.codehaus.plexus</groupId>
						<artifactId>plexus-compiler-eclipse</artifactId>
						<version>2.15.0</version>
					</dependency>
				</dependencies>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>integration</id>
			<dependencies>
				<dependency>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-security</artifactId>
				</dependency>
				<dependency>
					<groupId>com.nimbusds</groupId>
					<artifactId>nimbus-jose-jwt</artifactId>
					<version>10.5</version>
				</dependency>
				<dependency>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-mail</artifactId>
				</dependency>
				<dependency>
					<groupId>com.github.librepdf</groupId>
					<artifactId>openpdf</artifactId>
					<version>2.0.3</version>
				</dependency>
			</dependencies>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-resources-plugin</artifactId>
						<executions>
							<execution>
								<id>stage-core-sources</id>
								<phase>generate-sources</phase>
								<goals><goal>copy-resources</goal></goals>
								<configuration>
									<outputDirectory>${project.build.directory}/generated-sources/core</outputDirectory>
									<resources>
										<resource>
											<directory>../../pessoa-1/backend/src/main/java</directory>
											<excludes>
												<exclude>logistics/Application.java</exclude>
																<exclude>contracts/v1/AddressSnapshot.java</exclude>
																<exclude>contracts/v1/ContractException.java</exclude>
																<exclude>contracts/v1/OriginSnapshot.java</exclude>
																<exclude>contracts/v1/OriginType.java</exclude>
																<exclude>contracts/v1/PartnerLookupPort.java</exclude>
																<exclude>contracts/v1/StoreSnapshot.java</exclude>
																<exclude>contracts/v1/AssignmentRequest.java</exclude>
																<exclude>contracts/v1/AssignmentSnapshot.java</exclude>
																<exclude>contracts/v1/FleetAssignmentPort.java</exclude>
																<exclude>contracts/v1/FleetReleasePort.java</exclude>
																<exclude>contracts/v1/FleetType.java</exclude>
																<exclude>contracts/v1/ReleaseReason.java</exclude>
																<exclude>contracts/v1/ReleaseReceipt.java</exclude>
																<exclude>contracts/v1/ReleaseRequest.java</exclude>
																<exclude>contracts/v1/RouteSnapshot.java</exclude>
																<exclude>contracts/v1/RouteSnapshotPort.java</exclude>
																<exclude>contracts/v1/RouteStatus.java</exclude>
											</excludes>
										</resource>
										<resource>
											<directory>../../pessoa-3/backend/src/main/java</directory>
											<includes>
												<include>logistics/**/*.java</include>
											</includes>
											<excludes>
												<exclude>logistics/Application.java</exclude>
												<exclude>logistics/DevSeed.java</exclude>
											</excludes>
										</resource>
									</resources>
								</configuration>
							</execution>
							<execution>
								<id>stage-core-migrations</id>
								<phase>generate-resources</phase>
								<goals><goal>copy-resources</goal></goals>
								<configuration>
									<outputDirectory>${project.build.outputDirectory}/core</outputDirectory>
									<resources>
										<resource>
											<directory>../../pessoa-1/backend/src/main/resources</directory>
											<includes><include>db/migration/**/*.sql</include></includes>
										</resource>
										<resource>
											<directory>../../pessoa-3/backend/src/main/resources</directory>
											<includes><include>db/migration/**/*.sql</include></includes>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>build-helper-maven-plugin</artifactId>
						<version>3.6.1</version>
						<executions>
							<execution>
								<id>add-integration-sources</id>
								<phase>generate-sources</phase>
								<goals><goal>add-source</goal></goals>
								<configuration>
									<sources>
										<source>src/integration/java</source>
										<source>${project.build.directory}/generated-sources/core</source>
									</sources>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-maven-plugin</artifactId>
						<configuration>
							<mainClass>sprint4.IntegratedApplication</mainClass>
							<classifier>integration</classifier>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
